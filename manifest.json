{
  "manifest_version": 3,
  "name": "تدارُك - Tadaruq",
  "short_name": "تدارُك",
  "description": "تدارُك: قرآن وأذكار وعلم وفقه، مع خطة يومية وسجل متابعة ومواقيت صلاة وأدوات عملية أثناء التصفح.",
  "version": "24.4.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "activeTab",
    "contextMenus",
    "storage",
    "geolocation",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "https://dorar.net/*",
    "https://cdn.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "app/index.html"
  },
  "action": {
    "default_title": "فتح تدارُك"
  },
  "omnibox": {
    "keyword": "rafiq"
  },
  "commands": {
    "open-rafiq-search": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "فتح البحث الذكي في تدارُك"
    },
    "open-rafiq-notebook": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "فتح دفتر تدارُك"
    },
    "open-rafiq-plan": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "فتح خطة اليوم في تدارُك"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
